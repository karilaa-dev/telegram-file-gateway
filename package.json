{
  "name": "telegram-file-gateway",
  "version": "0.1.0",
  "description": "A credential-hiding Cloudflare Worker that streams Telegram Bot API files using short-lived signed grants.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "test": "tsx --test test/gateway.test.ts",
    "test:workers": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "unenv": "^2.0.0-rc.24",
    "vitest": "4.1.12",
    "wrangler": "4.116.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
